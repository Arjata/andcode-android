#!/system/bin/sh
# andcode-doctor — environment self-check (DESIGN §4.4 settings page / smoke-test backend, NAMING §4.1)
# Usage: andcode-doctor [--json]
#   No arguments: human-readable report (stdout); --json: machine-readable, stdout only, a single JSON object.
# Diagnostic checks (loader/shim/resolv/opencode/git/busybox) align with the AGENTS §5 task list.
set -u
JSON=0; [ "${1:-}" = "--json" ] && JSON=1
ROOT="${ANDCODE_ROOT:?ANDCODE_ROOT 未设置}"

pass=0; fail=0
json="{"
sep=" "

add() { # $1=name $2=true|false
  json="$json$sep\"$1\": $2"
  sep=", "
  if [ "$2" = true ]; then pass=$((pass+1)); else fail=$((fail+1)); fi
}
human() { [ $JSON -eq 1 ] && return; printf '%s %s\n' "$1" "$2"; }

chk() { # $1=name remaining arguments=command
  n="$1"; shift
  if "$@" >/dev/null 2>&1; then
    add "$n" true;  human "ok  " "$n"
  else
    add "$n" false; human "FAIL" "$n"
  fi
}

chk loader    "$ROOT/lib/ld-linux-aarch64.so.1" --version
chk shim      test -f "$ROOT/shim/libandcode-shim.so"
chk resolv    test -s "$ROOT/etc/resolv.conf"
chk ssl-certs test -s "$ROOT/etc/ssl/certs/ca-certificates.crt"
chk opencode  "$ROOT/bin/opencode" --version
chk git       "$ROOT/bin/git" --version
chk busybox   "$ROOT/bin/busybox" true

if [ $JSON -eq 1 ]; then
  printf '%s, \"_pass\": %s, \"_fail\": %s }\n' "$json" "$pass" "$fail"
else
  printf '----\n通过 %s / 失败 %s\n' "$pass" "$fail"
fi
[ "$fail" -eq 0 ]
