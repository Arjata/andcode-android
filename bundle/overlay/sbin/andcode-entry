#!/system/bin/sh
# andcode-entry — unified bundle entry point (DESIGN §4.1, NAMING §4.2)
# Usage: andcode-entry <sshd|shell|doctor> [args...]
set -eu

ROOT="${ANDCODE_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
export ANDCODE_ROOT="$ROOT"
export ANDCODE_TIER="${ANDCODE_TIER:-a}"
[ -d "$ROOT/tmp" ] || mkdir -p "$ROOT/tmp"
[ -d "$ROOT/home" ] || mkdir -p "$ROOT/home"

cmd="${1:-shell}"; shift || true

case "$cmd" in
  mkresolv|resolv)
    "$ROOT/sbin/andcode-mkresolv" "$@"
    ;;
  sshd)
    "$ROOT/sbin/andcode-mkresolv" >/dev/null
    # dropbear is wrapped by pack-bundle (ELF at sbin/dropbear.bin, wrapper at sbin/dropbear)
    HK="$ROOT/etc/dropbear_host_key"
    [ -f "$HK" ] || "$ROOT/sbin/dropbearkey" -t ed25519 -f "$HK"
    exec "$ROOT/sbin/dropbear" -r "$HK" -p 127.0.0.1:2222 -A -N "$ROOT/home" "$@"
    ;;
  shell)
    P="$ROOT/usr/lib/proot/proot"
    if [ -x "$P" ]; then
      export PROOT_LOADER="$ROOT/usr/lib/proot/loader"
      export LD_LIBRARY_PATH="$ROOT/usr/lib/proot${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      export PROOT_TMP_DIR="${ANDCODE_APP_DATA:-$ROOT/tmp}"
      exec "$P" \
        -b "$ROOT/etc/resolv.conf:/etc/resolv.conf" \
        -b "$ROOT/etc/ssl:/etc/ssl" \
        -b "$ROOT/etc/ssl:/usr/lib/ssl" \
        -b "$ROOT/etc/passwd:/etc/passwd" \
        -b "$ROOT/etc/group:/etc/group" \
        -b "$ROOT/etc/nsswitch.conf:/etc/nsswitch.conf" \
        -w "$ROOT" \
        "$ROOT/bin/busybox" sh -l
    fi
    exec "$ROOT/bin/busybox" sh -l
    ;;
  doctor)
    exec "$ROOT/bin/andcode-doctor"
    ;;
  *)
    echo "用法: andcode-entry <sshd|shell|doctor|mkresolv>"; exit 2
    ;;
esac
