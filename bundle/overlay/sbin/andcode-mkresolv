#!/system/bin/sh
# andcode-mkresolv — generate resolv.conf from Android (DESIGN §4.5, NAMING §4.2)
# Usage: andcode-mkresolv [output path]  (default: $ANDCODE_ROOT/etc/resolv.conf)
set -eu
OUT="${1:-${ANDCODE_ROOT:?ANDCODE_ROOT 未设置}/etc/resolv.conf}"

# Priority: explicit environment setting > runtime ndc/system property detection > public fallback
DNS="${ANDCODE_DNS:-}"
if [ -z "$DNS" ]; then
  # getprop is available in shell/App domains; callers inject ANDCODE_DNS for Tier P without a shell
  if command -v getprop >/dev/null 2>&1; then
    for i in 1 2 3 4; do
      d="$(getprop "net.dns$i" 2>/dev/null || true)"
      [ -n "$d" ] && DNS="$DNS $d"
    done
    # Common on Android 8+: net.dns1 is empty; fall back to rnd0 interface DNS or the system fallback
    if [ -z "$(printf '%s' "$DNS" | tr -d ' ')" ]; then
      d="$(getprop net.dns1 2>/dev/null || true)"
      [ -n "$d" ] && DNS="$d"
    fi
  fi
fi
[ -n "$(printf '%s' "$DNS" | tr -d ' ')" ] || DNS="1.1.1.1 8.8.8.8"

{
  for d in $DNS; do echo "nameserver $d"; done
  # Mobile networks/managed Wi-Fi often block outbound UDP 53 (ICMP/443 work): force TCP DNS
  echo "options use-vc timeout:3 attempts:2"
} > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
echo "resolv.conf → $OUT: $(tr '\n' ' ' < "$OUT")"
