# andcode — .gitignore
# See docs/DESIGN.md §5 for layout conventions and docs/NAMING.md §7.1 for release artifact naming.

# Build artifacts and working directories (generated by CI, not tracked)
# Release artifacts: andcode-bundle-*.tar.gz / .sha256
dist/
# CI/local temporary data: rootfs, stage, and jniLibs intermediate artifacts
work/
out/
build/
target/
*.tar
*.tar.gz
*.tar.zst
*.tgz
*.img
*.img.gz
__pycache__/
# Generated by packaging scripts; discarded with the artifacts
*.sha256
# Tier P link-farm manifest (generated by pack-apk-libs.sh)
manifest.farm

# ── Android / Gradle(app/ Tier P APK)────────────────────────────
*.apk
*.aab
*.keystore
!debug.keystore
local.properties
.gradle/
.cxx/
.externalNativeBuild/
captures/
*.jks

# IDE / editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Runtime artifacts (retrieved from physical devices/emulators)
*.log
sshd.log
dropbear_host_key
# Dropbear/SSH host-key related
*.pub

# Shim and baseline build intermediates
*.o
# Compiled artifacts; bundle libraries tracked in the manifest are excluded
*.so
!bundle/shim/**/*.so.patch
