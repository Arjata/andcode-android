# Line ending policy: development runs on Windows and CI on Linux; prevent CRLF contamination.
* text=auto

# Shell / build scripts and templates: require LF to avoid device-side /system/bin/sh parsing failures.
*.sh         text eol=lf
*.tpl        text eol=lf
*.prop       text eol=lf
Makefile     text eol=lf
*.mk         text eol=lf
runtime/ubuntu/andcode-* text eol=lf

# Source code and data formats
*.c          text eol=lf
*.h          text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.tsv        text eol=lf
LICENSE      text eol=lf

# Script executable bits (inherited by CI/packaging)
*.sh         text eol=lf

# Binary files (disable line ending conversion even if temporarily present in the future)
*.png        binary
*.ico        binary
*.tar.*      binary
*.keystore   binary

# Git LFS (allowlisted categories; see docs/LFS.md; placed last to override binary declarations above)
# Only test fixtures and documentation images may use LFS; build artifacts, keys, and libraries are prohibited (including LFS).
tests/fixtures/**/*.elf   filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.img   filter=lfs diff=lfs merge=lfs -text
docs/img/*.png            filter=lfs diff=lfs merge=lfs -text
docs/img/*.jpg            filter=lfs diff=lfs merge=lfs -text
docs/img/*.jpeg           filter=lfs diff=lfs merge=lfs -text
