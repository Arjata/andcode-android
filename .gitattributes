# 换行符策略:本仓库在 Windows 主机开发、Linux CI 执行,必须杜绝 CRLF 混入
* text=auto

# Shell / 构建脚本与模板:强制 LF(否则设备侧 /system/bin/sh 解析失败)
*.sh         text eol=lf
*.tpl        text eol=lf
*.prop       text eol=lf
Makefile     text eol=lf
*.mk         text eol=lf

# 源码与数据格式
*.c          text eol=lf
*.h          text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.tsv        text eol=lf
LICENSE      text eol=lf

# 脚本可执行位(CI/打包继承)
*.sh         text eol=lf

# 二进制(即使将来临时存在也不做换行转换)
*.png        binary
*.ico        binary
*.tar.*      binary
*.keystore   binary

# ── Git LFS(白名单类,规则见 docs/LFS.md;置于文件末尾以覆盖上方 binary 声明)──
# 只有两类文件允许 LFS:测试样张与文档图像;构建产物/密钥/库文件禁止入库(含 LFS)
tests/fixtures/**/*.elf   filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.img   filter=lfs diff=lfs merge=lfs -text
docs/img/*.png            filter=lfs diff=lfs merge=lfs -text
docs/img/*.jpg            filter=lfs diff=lfs merge=lfs -text
docs/img/*.jpeg           filter=lfs diff=lfs merge=lfs -text
